{
  "expo": {
    "name": "ParkMe",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-light.png",
    "scheme": "parkme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkme.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-icon.png",
        "monochromeImage": "./assets/images/android-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.parkme.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCCwj0f7Mmb9GMWHbKdyALRwjjt3Gy8SvY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ParkMe to use your location to find nearby parking spots."
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#000000"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e37b684d-8648-4e73-b110-f21a446799ac"
      }
    },
    "owner": "vettel",
    "updates": {
      "url": "https://u.expo.dev/e37b684d-8648-4e73-b110-f21a446799ac"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
